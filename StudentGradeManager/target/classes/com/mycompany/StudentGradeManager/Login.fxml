<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<VBox alignment="CENTER" spacing="20.0" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.studentgrademanager.LoginController" prefWidth="800.0" prefHeight="600.0">
    <padding>
        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0"/>
    </padding>
    <VBox alignment="CENTER" spacing="18.0" maxWidth="380.0" prefHeight="380.0" styleClass="card">
        <VBox alignment="CENTER" spacing="2.0">
            <Label text="Student Grade Manager" styleClass="login-title"/>
        </VBox>
        <Label text="Sign In to Your Account" styleClass="header-subtitle"/>
        <VBox spacing="12.0" alignment="CENTER" fillWidth="true">
            <TextField fx:id="usernameField" promptText="Username"/>
            <PasswordField fx:id="passwordField" promptText="Password"/>
        </VBox>
        <Button text="Login" onAction="#handleLogin" prefWidth="160.0" styleClass="nav-button"/>
        <Label fx:id="errorLabel" text="" textFill="#ff4444">
            <font>
                <Font size="12.0"/>
            </font>
        </Label>
    </VBox>
</VBox>