<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.studentgrademanager.AddGradeController">
   <top>
      <HBox prefHeight="55.0" prefWidth="810.0" BorderPane.alignment="CENTER">
         <children>
            <Pane prefHeight="55.0" prefWidth="810.0" styleClass="header">
               <children>
                  <Button fx:id="Dashboard" layoutX="570.0" layoutY="15.0" mnemonicParsing="false" onAction="#goToDashboard" styleClass="toggle-button" text="Dashboard"/>
                  
                  <Button fx:id="Home" layoutX="680.0" layoutY="15.0" mnemonicParsing="false" onAction="#goToHome" styleClass="toggle-button" text="Home"/>
               </children>
            </Pane>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" prefHeight="378.0" prefWidth="800.0" spacing="15" styleClass="card" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="header-subtitle" text="Student ID">
               <font>
                  <Font name="Calisto MT Bold" size="18.0"/>
               </font>
            </Label>
            <ComboBox fx:id="StudentID" prefWidth="200.0"/>
            <Label styleClass="header-subtitle" text="Subject">
               <font>
                  <Font name="Calisto MT Bold" size="18.0"/>
               </font>
            </Label>
            <TextField fx:id="Subject" maxWidth="200.0"/>
            <Label styleClass="header-subtitle" text="Student Grade">
               <font>
                  <Font name="Calisto MT Bold" size="18.0"/>
               </font>
            </Label>
            <TextField fx:id="StudentGrade" maxWidth="200.0"/>
            <Label fx:id="errorLabel" textFill="#dc0f0f">
               <font>
                  <Font size="14.0"/>
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="20" left="20" right="20" top="20"/>
         </padding>
      </VBox>
   </center>
   <bottom>
      <Pane prefHeight="110.0" prefWidth="200.0" styleClass="header" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="Enter" layoutX="330.0" layoutY="30.0" mnemonicParsing="false" onAction="#saveGrade" prefHeight="40.0" prefWidth="153.0" styleClass="toggle-button" text="Enter"/>
         </children>
      </Pane>
   </bottom>
</BorderPane>