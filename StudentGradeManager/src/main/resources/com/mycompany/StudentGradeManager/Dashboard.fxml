<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.studentgrademanager.DashboardController">
   <children>
      <VBox prefHeight="600.0" prefWidth="800.0" spacing="0">
         <children>
            <VBox prefHeight="100.0" prefWidth="800.0" styleClass="header">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="15">
                     <children>
                        <VBox spacing="3">
                           <children>
                              <Label fx:id="appName" styleClass="header-title" text="Student Grade Manager"/>
                              <Label fx:id="studentName" styleClass="header-subtitle" text="Welcome!"/>
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="toggleModeBtn" onAction="#onToggleModeClicked" styleClass="toggle-button" text="🌙 Dark Mode"/>
                     </children>
                     <padding>
                        <Insets bottom="15" left="20" right="20" top="15"/>
                     </padding>
                  </HBox>
               </children>
            </VBox>
            <HBox prefWidth="800.0" spacing="20">
               <children>
                  <VBox prefWidth="220" spacing="8" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="Total Students"/>
                        <Label fx:id="totalStudentsLabel" styleClass="card-value" text="0"/>
                     </children>
                  </VBox>
                  <VBox prefWidth="220" spacing="8" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="Average Grade"/>
                        <Label fx:id="averageGradeLabel" styleClass="card-value" text="0"/>
                     </children>
                  </VBox>
                  <VBox prefWidth="220" spacing="8" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="Highest Grade"/>
                        <Label fx:id="highestGradeLabel" styleClass="card-value" text="0"/>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20" left="20" right="20" top="20"/>
               </padding>
            </HBox>
            <VBox prefWidth="800.0" spacing="10">
               <children>
                  <Button onAction="#onAddStudentClicked" prefWidth="760.0" styleClass="nav-button" text="➕ Add Student"/>
                  <Button onAction="#onAddGradesClicked" prefWidth="760.0" styleClass="nav-button" text="📝 Add Grades"/>
                  <Button onAction="#onViewStudentsClicked" prefWidth="760.0" styleClass="nav-button" text="👁 View Students"/>
                  <Button onAction="#onViewReportsClicked" prefWidth="760.0" styleClass="nav-button" text="📊 View Reports"/>
               </children>
               <padding>
                  <Insets bottom="20" left="20" right="20" top="10"/>
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>